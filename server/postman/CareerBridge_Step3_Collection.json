        {
          "name": "Create Student Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{STUDENT_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"college\": \"National Institute of Technology\",\n  \"degree\": \"B.Tech\",\n  \"branch\": \"CSE\",\n  \"graduationYear\": 2026,\n  \"cgpa\": 8.75,\n  \"backlogs\": 0,\n  \"skills\": [\"JavaScript\", \"React\", \"Node.js\", \"MongoDB\"],\n  \"bio\": \"Passionate full-stack developer\",\n  \"location\": \"Bangalore\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/students/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "students", "profile"]
            }
          }
        },
        {
