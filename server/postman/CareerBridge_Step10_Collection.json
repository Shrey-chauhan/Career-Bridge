{
  "info": {
    "name": "CareerBridge API - Step 10 Placement Analytics & Intelligence",
    "description": "Postman collection for Step 10 Placement Analytics endpoints, recruitment conversion funnel, time-series application trends, company/job/branch performance breakdowns, insights generation, CSV export, and RBAC security rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
