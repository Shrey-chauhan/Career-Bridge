      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/admin/analytics/overview?from=2026-01-01&to=2026-12-31",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "admin", "analytics", "overview"],
          "query": [
